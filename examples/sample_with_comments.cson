# Device configuration
# Generated by hand -- please keep the comments when editing.

name = "grid-controller"

# Network settings for the control server
server: {
  host: "localhost"
  port: 8080  # overridden in prod, see deploy notes
}

# One entry per physical button on the grid
buttons: [
  "record"
  "play"
  "stop"  # long-press stops all channels, not just this one
]

retries: 3
